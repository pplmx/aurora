    "ISS-oracle-ipv6-ssrf": {
      "id": "ISS-oracle-ipv6-ssrf",
      "type": "issue",
      "status": "resolved",
      "version": 2,
      "created_at": "2026-08-22T15:17:33+00:00",
      "updated_at": "2026-08-22T15:19:11+00:00",
      "touched_round": 1,
      "title": "SSRF guard misses bracketed IPv6 literals",
      "summary": "validateSourceURL/hostBlocked fails to recognize bracketed IPv6 URL hosts: net.ParseIP(\"[::1]\") is nil (brackets not accepted), so [::1], [fc00::1], [fe80::1] fall through to DNS lookup, which fails -> reported NOT blocked on every host. All IPv6-literal SSRF vectors bypass the guard."
    },
    "ISS-http-probe-panic": {
      "id": "ISS-http-probe-panic",
      "type": "issue",
      "status": "resolved",
      "version": 2,
      "created_at": "2026-08-22T15:17:33+00:00",
      "updated_at": "2026-08-22T15:19:11+00:00",
      "touched_round": 1,
      "title": "http loopback probe panics instead of skipping",
      "summary": "loopbackReachable() calls httptest.NewServer which panics (\"listen tcp6 [::1]:0: socket: operation not permitted\") in environments that deny loopback bind, so TestMain crashes instead of gracefully setting loopbackBlocked=true. Contradicts decision-http-tests-env-skip (just test green on this host)."
    },
